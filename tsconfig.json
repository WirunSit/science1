{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@shared/*": ["./apps/shared/*"],
      "@content/*": ["./content/*"]
    }
  },
  "include": ["apps", "content", "scripts", "slides", "worksheets", "tests", "*.ts"]
}
